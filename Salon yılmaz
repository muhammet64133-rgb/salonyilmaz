<script>
function updateClockAndStatus() {
  const now = new Date();
  
  // Canlı Saat (Saat:Dakika:Saniye)
  const hours = String(now.getHours()).padStart(2, '0');
  const minutes = String(now.getMinutes()).padStart(2, '0');
  const seconds = String(now.getSeconds()).padStart(2, '0');
  document.getElementById('live-clock').textContent = `${hours}:${minutes}:${seconds}`;

  // Canlı Tarih
  const options = { day: 'numeric', month: 'long', weekday: 'long' };
  document.getElementById('live-date').textContent = now.toLocaleDateString('tr-TR', options);

  // Çalışma Durumu (Pzt-Cmt 08:30 - 21:00 arası Açık, Pazar Kapalı)
  const day = now.getDay(); // 0 = Pazar
  const currentMinutes = now.getHours() * 60 + now.getMinutes();
  const openMinutes = 8 * 60 + 30; // 08:30
  const closeMinutes = 21 * 60;    // 21:00

  const statusBadge = document.getElementById('live-status');

  if (day !== 0 && currentMinutes >= openMinutes && currentMinutes < closeMinutes) {
    statusBadge.textContent = "🟢 ŞU AN AÇIK";
    statusBadge.className = "live-status-badge status-open";
  } else {
    statusBadge.textContent = "🔴 ŞU AN KAPALI";
    statusBadge.className = "live-status-badge status-closed";
  }
}

setInterval(updateClockAndStatus, 1000);
updateClockAndStatus();
</script>

